# The bot's interactive session: a plain Claude Code session in tmux, as the
# unprivileged "agent" user, for jmarrero to attach to. See README.md.
# Build: podman build -t localhost/bot-coordinator bot/coordinator/
# (after building localhost/bootc-bot-agent from bot/agent.Containerfile)
FROM localhost/bootc-bot-agent:latest

COPY --chmod=755 entrypoint.sh /usr/local/bin/bot-coordinator-entrypoint
COPY --chmod=755 render-skills.py /usr/local/bin/render-skills
COPY operator-goals.md session.md /usr/local/share/bot-coordinator/
ENV PATH=/home/agent/.local/bin:/home/agent/.cargo/bin:/usr/local/bin:/usr/bin:/bin \
    BOT_LOGIN=jmarrero-bot \
    HOMEGIT_URL=https://github.com/jmarrero-forge/homegit.git
WORKDIR /home/agent
ENTRYPOINT ["/usr/local/bin/bot-coordinator-entrypoint"]
