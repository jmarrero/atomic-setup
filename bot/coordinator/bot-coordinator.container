# Quadlet for the bot's coordinator. Install:
#   ln -s $PWD/bot/coordinator/bot-coordinator.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload && systemctl --user start bot-coordinator
[Unit]
Description=Bot coordinator: homegit's coordinator skill in Claude Code
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=bot-coordinator
Image=localhost/bot-coordinator:latest
# Credentials as podman secrets (see bot/SETUP.md), never in the image.
Secret=jmarrero-bot-gh-token,type=env,target=GH_TOKEN
Secret=jmarrero-bot-claude-token,type=env,target=CLAUDE_CODE_OAUTH_TOKEN
# The persistent home: clones, Claude's sessions, caches, devspace keys.
# No keep-id: the container's users map to subordinate ids, not to you.
Volume=bot-coordinator-home:/home/agent
Volume=%h/.config/bot-harness/operator.json:/home/agent/.config/bot-harness/operator.json:ro,z
# Network through the host (pasta), which is on the tailnet.
PodmanArgs=--memory=16g --cpus=4 --pids-limit=8192
NoNewPrivileges=true
DropCapability=all
# Uncomment to have it start working on its own after each start:
#Environment=COORDINATOR_PROMPT=Load the coordinator skill and run the bot.

[Service]
Restart=on-failure
RestartSec=60
TimeoutStartSec=900

[Install]
WantedBy=default.target
