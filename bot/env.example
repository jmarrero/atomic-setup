# Copy to ~/.config/bootc-bot/env and chmod 600.

# Bot machine account, classic PAT with scopes: notifications, public_repo
# (fine-grained PATs can't read notifications). Used to read threads and post replies.
BOTD_GITHUB_TOKEN=

# YOUR token (you must be a bootc-dev member), classic PAT with read:org only.
# Needed to see private org members; never passed to agents.
BOTD_MEMBERSHIP_TOKEN=

# Agent model credentials are podman secrets, not env vars here: see README.md
# and [agents.<name>.secrets] in config.example.toml.
