# Copy to ~/.config/bootc-bot/env and chmod 600.

# Bot machine account, classic PAT with scopes: notifications, public_repo
# (fine-grained PATs can't read notifications). Used to read threads and post replies.
BOTD_GITHUB_TOKEN=

# YOUR token (you must be a bootc-dev member), classic PAT with read:org only.
# Needed to see private org members; never passed to agents.
BOTD_MEMBERSHIP_TOKEN=

# Optional API credentials for custom agent configurations with an env list.
# The default Claude/Codex configuration mounts local logins instead.
# Agent credentials, passed only into job containers. Use spend-capped keys:
# a prompt-injected agent could leak whatever it holds.
ANTHROPIC_API_KEY=
CODEX_API_KEY=
# Fine-grained PAT with the "Copilot Requests" permission
COPILOT_GITHUB_TOKEN=
