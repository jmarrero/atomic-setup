# The pod's own tailnet node, `praxis-broker` with tag:praxis-broker, so
# that agentic-job's runners reach Praxis without reaching this machine
# (README.md, "Network"). tailscaled runs in userspace mode: no TUN device,
# no capabilities, and no change to the host's network or its own
# Tailscale. It hands every connection the tailnet policy lets in to the
# same port on the pod's loopback, where Praxis listens on 8081; the policy
# (../tailscale-policy.hujson) is what keeps every other port shut.
[Unit]
Description=Praxis credential broker: the pod's tailnet node
Requires=praxis-credential-broker-pod.service
After=praxis-credential-broker-pod.service

[Container]
ContainerName=praxis-credential-broker-tailscale
# Pinned by digest (README.md, "Updating"). v1.104.1:
# https://github.com/tailscale/tailscale/releases/tag/v1.104.1
Image=ghcr.io/tailscale/tailscale@sha256:87c55d6be56ad85b3d8bceca5f87f73de288c609131460dd1be1874c250cc41d
Pod=praxis-credential-broker.pod
Environment=TS_HOSTNAME=praxis-broker
Environment=TS_EXTRA_ARGS=--advertise-tags=tag:praxis-broker
Environment=TS_USERSPACE=true
Environment=TS_ACCEPT_DNS=false
# The first start logs in with a one-time, pre-approved auth key tagged
# tag:praxis-broker (README.md, step 2), read from the secret's file by
# `tailscale up --authkey=file:...`, so it is in no environment. After
# that, the node's key in the state volume logs it in again on every start,
# and the auth key, used up, is never read again.
Secret=praxis-credential-broker-tailscale-authkey,target=/run/secrets/tailscale/authkey,uid=65532,gid=65532,mode=0400
Environment=TS_AUTHKEY=file:/run/secrets/tailscale/authkey
Environment=TS_AUTH_ONCE=true
Environment=TS_STATE_DIR=/var/lib/tailscale
Volume=praxis-credential-broker-tailscale:/var/lib/tailscale
# Where the CLI looks by default, so `podman exec ... tailscale status`
# needs no --socket (the image's /var/run is a link to /run).
Environment=TS_SOCKET=/var/run/tailscale/tailscaled.sock
Tmpfs=/run/tailscale:rw,nosuid,nodev,size=1m
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
User=65532
Group=65532
ReadOnly=true
DropCapability=all
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=300s
