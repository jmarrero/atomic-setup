# Praxis, the only container that holds the broker's Claude token: upstream's
# contrib/quadlet unit at 45fbb14c7a66, with the image pinned by digest
# instead of following :main, and this directory's praxis.yaml and run-token
# policy mounted from the checkout. See README.md.
[Unit]
Description=Praxis credential broker gateway
Requires=praxis-credential-broker-pod.service
After=praxis-credential-broker-pod.service

[Container]
ContainerName=praxis-credential-broker-praxis
# Pinned by digest, never a tag: this process holds the token, so whoever
# can push a tag would control it. No AutoUpdate: a new image is a pull
# request moving this line (README.md, "Updating").
# Built from cgwalters-bot/praxis-credential-broker 45fbb14c7a66328ad19e411820fbd58484767e39
# (also tagged :45fbb14c7a66328ad19e411820fbd58484767e39), by
# https://github.com/cgwalters-bot/praxis-credential-broker/actions/runs/38374076376
Image=ghcr.io/cgwalters-bot/praxis-credential-broker-gateway@sha256:c31618f5f236c6e376bb5de25e38e858fe3386c6c3a0f9c3c43c2a6d0edefbb7
Pod=praxis-credential-broker.pod
User=65532
Group=65532
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
# `claude setup-token`'s token, stored as README.md says. The entrypoint
# exports it into Praxis's environment only, never the container's config.
Secret=praxis-credential-broker-anthropic-oauth,target=/run/secrets/anthropic/oauth-token,uid=65532,gid=65532,mode=0400
# Directories, not files: git replaces a file it updates, and a bind mount
# of the file would keep the old one. Relative to this unit's directory in
# the checkout, which the install's directory symlink keeps. Praxis is
# 65532 and reads them as "other", so they must stay world-readable.
# This directory's praxis.yaml replaces the image's.
Volume=./praxis:/etc/praxis:ro,z
# run-token-policy.yaml; no operator-tokens.yaml, so no operators.
Volume=./policy:/etc/praxis-credential-broker:ro,z
Tmpfs=/tmp:rw,noexec,nosuid,nodev,size=64m
# Podman 5.8 fails to create a container with a scheduled health check
# when it has no systemd user bus, so never schedule one.
PodmanArgs=--no-healthcheck

[Service]
Restart=always
RestartSec=5s
# The first start pulls the image.
TimeoutStartSec=300s
